# 复制为 .env 后按环境填写。本地与云端各写一份，不要提交。

# ---- 模型服务（OpenAI 兼容）----
# 本地：DashScope 或 Ollama；云端：vLLM
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=qwen-plus

# ---- 裁判模型：必须与生成模型不同源，否则是自评自测 ----
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL=qwen3.8-flash

# ---- 向量与重排（本地模型路径，留空则走 API）----
# 云端填 /root/autodl-tmp/models/bge-m3
EMBEDDING_MODEL=
EMBEDDING_DIM=1024
# 云端填 /root/autodl-tmp/models/bge-reranker-v2-m3
RERANK_MODEL=

# ---- 存储 ----
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=policy_chunks
MYSQL_URL=mysql+pymysql://root:root@localhost:3306/ecom
REDIS_URL=redis://localhost:6379/0

# ---- 安全 ----
JWT_SECRET=change-me-in-production
JWT_EXPIRE_SECONDS=7200
RATE_LIMIT_USER_PER_MIN=20
RATE_LIMIT_GLOBAL_QPS=10

# ---- 路径（相对路径按项目根解析）----
MODEL_DIR=models
DATA_DIR=data
OUTPUT_DIR=outputs

# ---- 检索参数 ----
RECALL_TOP_K=20
FINAL_TOP_K=5
RRF_K=60
# 三路权重：FAQ 精确匹配 / 稠密 / 稀疏
RRF_WEIGHTS=1.2,1.0,0.8
RERANK_LOW=0.4
RERANK_HIGH=0.7

# ---- 日志 ----
LOG_LEVEL=INFO
